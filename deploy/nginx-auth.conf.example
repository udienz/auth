# nginx site for authentik (one instance, two hostnames: auth.udienz.web.id and
# auth-qa.udienz.web.id, both proxied to 127.0.0.1:9000).
# Install as /etc/nginx/sites-available/auth.udienz.web.id, symlink into sites-enabled, then:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d auth.udienz.web.id -d auth-qa.udienz.web.id   # adds 443 and the redirect
# DNS (Cloudflare) must point both names at the server first.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name auth.udienz.web.id auth-qa.udienz.web.id;

    client_max_body_size 5m;

    # Public pages for Google's OAuth consent screen: home page and privacy policy. They are
    # rendered by scripts/render-public.sh into /srv/auth/site on every deploy. Everything else
    # goes to authentik. `/` is served here, so authentik's own redirect from `/` is not used;
    # people reach the sign-in flow from the apps, and the admin uses /if/admin/.
    location = / {
        root /srv/auth/site;
        try_files /index.html =404;
    }
    location = /privacy {
        root /srv/auth/site;
        try_files /privacy.html =404;
    }
    location ^~ /public-assets/ {
        alias /srv/auth/site/;
    }

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # authentik uses WebSockets (admin UI, outposts)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
