# Copy to .env (git-ignored) and fill in. Generate each secret with: openssl rand -base64 36
PG_PASS=
AUTHENTIK_SECRET_KEY=
# Pin the version deliberately; upgrade one release at a time and read the release notes.
AUTHENTIK_TAG=2026.8.5
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Host port on 127.0.0.1. Production: 9000. QA (separate checkout in /srv/auth-qa): 9001.
# scripts/deploy.sh refuses to deploy if this does not match the environment.
COMPOSE_PORT_HTTP=9000
